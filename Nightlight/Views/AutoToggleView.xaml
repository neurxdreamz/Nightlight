<UserControl x:Class="Nightlight.Views.AutoToggleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel RenderTransformOrigin="0.5,0.5" Height="316">
        <StackPanel.RenderTransform>
            <TransformGroup>
                <ScaleTransform/>
                <SkewTransform AngleX="-0.346"/>
                <RotateTransform/>
                <TranslateTransform X="-0.931"/>
            </TransformGroup>
        </StackPanel.RenderTransform>

        <TextBlock Text="Автовключение по датчикам"
                   Foreground="White"
                   FontSize="18"
                   FontWeight="Bold"
                   Margin="0,0,0,20"/>

        <CheckBox Content="Движение обнаружено"
                  IsChecked="{Binding IsMotionDetected}"
                  Foreground="White"
                  FontSize="14"
                  Margin="0,0,0,15"/>

        <TextBlock Text="Яркость окружения (0-100):"
                   Foreground="#CBD5E1"
                   FontSize="13"
                   Margin="0,0,0,5"/>

        <TextBox Text="{Binding AmbientLightText, UpdateSourceTrigger=PropertyChanged}"
         Width="120"
         HorizontalAlignment="Left"
         FontSize="14"
         Padding="6"
         Margin="0,0,0,20"/>

        <Button Content="Выполнить"
                Command="{Binding ExecuteCommand}"
                Width="140"
                Height="36"
                HorizontalAlignment="Left"
                FontSize="14"
                Background="#4F46E5"
                Foreground="White"
                BorderThickness="0"
                Margin="0,0,0,20"/>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <Ellipse Width="14" Height="14"
                     Fill="{Binding IsPreConditionMet, Converter={StaticResource BoolToBrush}}"/>
            <TextBlock Margin="8,0,0,0"
                       VerticalAlignment="Center"
                       Foreground="White"
                       FontSize="13">
                <Run Text="Предусловие: "/>
                <Run Text="{Binding IsPreConditionMet, Converter={StaticResource BoolToText}}"/>
            </TextBlock>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
            <Ellipse Width="14" Height="14"
                     Fill="{Binding IsPostConditionMet, Converter={StaticResource NullableBoolToBrush}}"/>
            <TextBlock Margin="8,0,0,0"
                       VerticalAlignment="Center"
                       Foreground="White"
                       FontSize="13">
                <Run Text="Постусловие: "/>
                <Run Text="{Binding IsPostConditionMet, Converter={StaticResource NullableBoolToText}}"/>
            </TextBlock>
        </StackPanel>

        <Button Content="Показать контракт"
                Command="{Binding ShowContractCommand}"
                Width="200"
                Height="36"
                HorizontalAlignment="Left"
                FontSize="14"
                Background="#334155"
                Foreground="White"
                BorderThickness="0"/>

    </StackPanel>
</UserControl>
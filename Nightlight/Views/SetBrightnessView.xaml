<UserControl x:Class="Nightlight.Views.SetBrightnessView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="10">

        <TextBlock Text="Ручная установка яркости"
                   Foreground="White"
                   FontSize="18"
                   FontWeight="Bold"
                   Margin="0,0,0,20"/>

        <TextBlock Text="Целевая яркость (1-100):"
                   Foreground="#CBD5E1"
                   FontSize="13"
                   Margin="0,0,0,5"/>

        <TextBox Text="{Binding TargetBrightnessText, UpdateSourceTrigger=PropertyChanged}"
         Width="120"
         HorizontalAlignment="Left"
         FontSize="14"
         Padding="6"
         Margin="0,0,0,20"/>

        <Button Content="Выполнить"
        Command="{Binding ExecuteCommand}"
        Width="140"
        Height="36"
        HorizontalAlignment="Left"
        FontSize="14"
        BorderThickness="0"
        Margin="0,0,0,20">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Background" Value="#4F46E5"/>
                    <Setter Property="Foreground" Value="White"/>

                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                                    <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                                </Border>

                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#4338CA"/>
                                    </Trigger>

                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Background" Value="#334155"/>
                                        <Setter Property="Foreground" Value="#64748B"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Button.Style>
        </Button>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <Ellipse Width="14" Height="14"
                     Fill="{Binding IsPreConditionMet, Converter={StaticResource BoolToBrush}}"/>
            <TextBlock Margin="8,0,0,0"
                       VerticalAlignment="Center"
                       Foreground="White"
                       FontSize="13">
                <Run Text="Предусловие: "/>
                <Run Text="{Binding IsPreConditionMet, Converter={StaticResource BoolToText}}"/>
            </TextBlock>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
            <Ellipse Width="14" Height="14"
                     Fill="{Binding IsPostConditionMet, Converter={StaticResource NullableBoolToBrush}}"/>
            <TextBlock Margin="8,0,0,0"
                       VerticalAlignment="Center"
                       Foreground="White"
                       FontSize="13">
                <Run Text="Постусловие: "/>
                <Run Text="{Binding IsPostConditionMet, Converter={StaticResource NullableBoolToText}}"/>
            </TextBlock>
        </StackPanel>

        <Button Content="Показать контракт"
                Command="{Binding ShowContractCommand}"
                Width="200"
                Height="36"
                HorizontalAlignment="Left"
                FontSize="14"
                Background="#334155"
                Foreground="White"
                BorderThickness="0"/>

    </StackPanel>
</UserControl>
<UserControl x:Class="Nightlight.Views.FragmentConstructorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#4F46E5"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#4338CA"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#334155"/>
                                <Setter Property="Foreground" Value="#64748B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#334155"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#475569"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MonospaceBox" TargetType="TextBox">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="AcceptsTab" Value="True"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
        </Style>

    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="239*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="307*"/>
            <ColumnDefinition Width="23*"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="275*"/>
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Grid.ColumnSpan="2" Grid.RowSpan="2">
            <StackPanel>

                <TextBlock Text="Конструктор фрагмента (wp)"
                           Foreground="White"
                           FontSize="20"
                           FontWeight="Bold"
                           Margin="0,0,0,15"/>

                <TextBlock Text="Готовые сценарии:"
                           Foreground="#CBD5E1"
                           FontSize="13"
                           Margin="0,0,0,5"/>
                <ComboBox ItemsSource="{Binding Presets}"
                          SelectedItem="{Binding SelectedPreset}"
                          DisplayMemberPath="Name"
                          Margin="0,0,0,15"
                          Padding="6"
                          FontSize="13"/>

                <TextBlock Text="Код фрагмента (:=, if/else, ;):"
                           Foreground="#CBD5E1"
                           FontSize="13"
                           Margin="0,0,0,5"/>
                <TextBox Text="{Binding CodeText, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource MonospaceBox}"
                         Height="150"
                         Margin="0,0,0,15"/>

                <TextBlock Text="Цель (Post) — краткая запись:"
                           Foreground="#CBD5E1"
                           FontSize="13"
                           Margin="0,0,0,5"/>
                <TextBox Text="{Binding PostShortText, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource MonospaceBox}"
                         Height="50"
                         Margin="0,0,0,10"/>

                <TextBlock Text="Цель (Post) — человеческим языком:"
                           Foreground="#CBD5E1"
                           FontSize="13"
                           Margin="0,0,0,5"/>
                <TextBox Text="{Binding PostHumanText, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource MonospaceBox}"
                         Height="50"
                         FontFamily="Segoe UI"
                         TextWrapping="Wrap"
                         Margin="0,0,0,15"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Ellipse Width="14" Height="14"
                             Fill="{Binding IsPreConditionMet, Converter={StaticResource BoolToBrush}}"/>
                    <TextBlock Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="White"
                               FontSize="13">
                        <Run Text="Данные для расчёта: "/>
                        <Run Text="{Binding IsPreConditionMet, Converter={StaticResource BoolToText}}"/>
                    </TextBlock>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                    <Button Content="Рассчитать wp"
                            Command="{Binding CalculateWpCommand}"
                            Style="{StaticResource PrimaryButton}"
                            Width="160" Height="38"
                            Margin="0,0,10,0"/>

                    <Button Content="Показать триаду"
                            Command="{Binding ShowTriadCommand}"
                            Style="{StaticResource SecondaryButton}"
                            Width="160" Height="38"/>
                </StackPanel>

                <Border Background="#7F1D1D"
                        CornerRadius="4"
                        Padding="10"
                        Margin="0,0,0,10"
                        Visibility="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyToVisibility}}">
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="#FECACA"
                               FontSize="13"
                               TextWrapping="Wrap"/>
                </Border>

                <TextBlock Text="Итоговое предусловие (wp):"
                           Foreground="#CBD5E1"
                           FontSize="13"
                           FontWeight="Bold"
                           Margin="0,10,0,5"/>
                <Border Background="#1E293B"
                        BorderBrush="#334155"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="10"
                        Margin="0,0,0,10">
                    <TextBlock Text="{Binding FinalWpShort}"
                               Foreground="#93C5FD"
                               FontFamily="Consolas"
                               FontSize="14"
                               TextWrapping="Wrap"/>
                </Border>

                <TextBlock Text="Человеческим языком:"
                           Foreground="#CBD5E1"
                           FontSize="13"
                           Margin="0,0,0,5"/>
                <TextBlock Text="{Binding FinalWpHuman}"
                           Foreground="White"
                           FontSize="13"
                           TextWrapping="Wrap"
                           Margin="0,0,0,10"/>

            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Column="3" Grid.RowSpan="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="Пошаговый трейс (с конца к началу):"
                       Foreground="White"
                       FontSize="15"
                       FontWeight="Bold"
                       Margin="0,0,0,10"/>

            <ListBox Grid.Row="1"
                     ItemsSource="{Binding TraceSteps}"
                     Background="#0F172A"
                     BorderBrush="#334155"
                     BorderThickness="1"
                     Foreground="White"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#1E293B"
                                CornerRadius="4"
                                Padding="10"
                                Margin="0,4">
                            <StackPanel>
                                <TextBlock Text="{Binding DisplayText}"
                                           Foreground="#93C5FD"
                                           FontFamily="Consolas"
                                           FontSize="12"
                                           TextWrapping="Wrap"/>
                                <TextBlock Margin="0,6,0,0"
                                           Foreground="#94A3B8"
                                           FontSize="11"
                                           TextWrapping="Wrap">
                                    <Run Text="Было: "/>
                                    <Run Text="{Binding ConditionBefore}"/>
                                </TextBlock>
                                <TextBlock Foreground="#86EFAC"
                                           FontSize="11"
                                           TextWrapping="Wrap">
                                    <Run Text="Стало: "/>
                                    <Run Text="{Binding ConditionAfter}"/>
                                </TextBlock>
                                <TextBlock Foreground="#FCA5A5"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Visibility="{Binding DefinednessCondition, Converter={StaticResource StringNotEmptyToVisibility}}">
                                    <Run Text="ОДЗ: "/>
                                    <Run Text="{Binding DefinednessCondition}"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Border Grid.Row="2"
                    Background="#1E293B"
                    BorderBrush="#4F46E5"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="12"
                    Margin="0,10,0,0"
                    Visibility="{Binding IsTriadVisible, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="Триада Хоара {Pre} P {Post}:"
                               Foreground="#A5B4FC"
                               FontSize="13"
                               FontWeight="Bold"
                               Margin="0,0,0,6"/>
                    <TextBlock Text="{Binding HoareTriadText}"
                               Foreground="White"
                               FontFamily="Consolas"
                               FontSize="12"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
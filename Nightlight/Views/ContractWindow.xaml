<Window x:Class="Nightlight.Views.ContractWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Height="450" Width="600"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0"
                   Text="{Binding Title}"
                   FontSize="20"
                   FontWeight="Bold"
                   Margin="0,0,0,15"/>

        <!-- Pre -->
        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <TextBlock Text="Предусловие (Pre):" FontWeight="Bold"/>
            <TextBlock Text="{Binding Pre}" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Post -->
        <StackPanel Grid.Row="2" Margin="0,0,0,10">
            <TextBlock Text="Постусловие (Post):" FontWeight="Bold"/>
            <TextBlock Text="{Binding Post}" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Effects -->
        <StackPanel Grid.Row="3" Margin="0,0,0,10">
            <TextBlock Text="Эффекты и исключения:" FontWeight="Bold"/>
            <TextBlock Text="{Binding Effects}" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Valid example -->
        <StackPanel Grid.Row="4" Margin="0,0,0,10">
            <TextBlock Text="Валидный пример:" FontWeight="Bold"/>
            <TextBlock Text="{Binding ValidExample}" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Invalid example + кнопка закрытия -->
        <StackPanel Grid.Row="5" Margin="0,0,0,10">
            <TextBlock Text="Невалидный пример:" FontWeight="Bold"/>
            <TextBlock Text="{Binding InvalidExample}" TextWrapping="Wrap"/>
            <Button Content="Закрыть"
                    Width="100"
                    HorizontalAlignment="Right"
                    Margin="0,15,0,0"
                    Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
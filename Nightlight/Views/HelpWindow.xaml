<Window x:Class="Nightlight.Views.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Справка" Height="500" Width="600"
        WindowStartupLocation="CenterOwner"
        Background="#0F172A">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding TitleText}" 
                   Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,0,0,15"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <TextBlock Text="{Binding HelpText}" 
                       Foreground="#CBD5E1" FontSize="14" TextWrapping="Wrap" LineHeight="22"/>
        </ScrollViewer>

        <Button Grid.Row="2" Content="Закрыть" Width="100" Height="35" 
                HorizontalAlignment="Right" Margin="0,15,0,0"
                Background="#4F46E5" Foreground="White" BorderThickness="0"
                Click="CloseButton_Click"/>
    </Grid>
</Window>
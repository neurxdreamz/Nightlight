<Window x:Class="Nightlight.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ночник"
        Height="677" Width="950"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ЛЕВАЯ ПАНЕЛЬ -->
        <Border Grid.Column="0" Background="#1E293B">
            <StackPanel>
                <TextBlock Text="🌙  НОЧНИК"
                           Foreground="White"
                           FontSize="20"
                           FontWeight="Bold"
                           Margin="20,25,20,25"/>

                <ListBox ItemsSource="{Binding Operations}"
                         SelectedItem="{Binding SelectedOperation}"
                         Background="Transparent"
                         BorderThickness="0"
                         Margin="10,0">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="12,10"/>
                            <Setter Property="Margin" Value="0,3"/>
                            <Setter Property="FontSize" Value="14"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd"
                                                Background="{TemplateBinding Background}"
                                                CornerRadius="8"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#334155"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#4F46E5"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Title}"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </Border>

        <!-- ПРАВАЯ ЧАСТЬ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="220"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ВИЗУАЛЬНАЯ ЛАМПА -->
            <Grid Grid.Row="0" Background="#0B1220">

                <!-- Свечение -->
                <Ellipse Width="180" Height="180"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Opacity="{Binding CurrentBrightness, Converter={StaticResource BrightnessToOpacity}}">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#FFFFC94A" Offset="0"/>
                            <GradientStop Color="#66FFC94A" Offset="0.5"/>
                            <GradientStop Color="#00FFC94A" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <!-- Ядро лампы -->
                <Ellipse Width="60" Height="60"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Fill="{Binding IsNightlightOn, Converter={StaticResource IsOnToGlow}}"/>

                <!-- Статус -->
                <TextBlock HorizontalAlignment="Center"
                           VerticalAlignment="Bottom"
                           FontSize="13"
                           Margin="0,0,0,15">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#94A3B8"/>
                            <Setter Property="Text" Value="Ночник выключен"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsNightlightOn}" Value="True">
                                    <Setter Property="Text" Value="Тёплый свет · 2700K"/>
                                    <Setter Property="Foreground" Value="#FFC94A"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <Border Grid.Row="1"
                    Background="#1E293B"
                    CornerRadius="12"
                    Margin="20"
                    Padding="25">
                <ContentControl Content="{Binding SelectedOperation}"/>
            </Border>
        </Grid>
    </Grid>
</Window>